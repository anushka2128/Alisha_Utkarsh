rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /blessings/{blessingId} {
      // 1. Visible on all phones in real-time
      allow read: if true;

      // 2. Any guest can post a blessing or ukhana
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.msg is string
                    && request.resource.data.msg.size() > 0;

      // 3. ONLY THE AUTHOR CAN DELETE (server-enforced)
      // Nobody can delete someone else's blessing
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;

      // 4. Blessings cannot be modified
      allow update: if false;
    }
  }
}
